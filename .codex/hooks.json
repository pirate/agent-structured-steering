{
  "description": "Inject changed dynamic steering state into Codex context.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/steering-overlay-poc/observer.py\" --hook",
        "additionalContextLimit": 4000
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/steering-overlay-poc/observer.py\" --hook",
        "additionalContextLimit": 4000
      }]
    }],
    "PreToolUse": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/steering-overlay-poc/observer.py\" --hook",
        "additionalContextLimit": 4000
      }]
    }],
    "PostToolUse": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/steering-overlay-poc/observer.py\" --hook",
        "additionalContextLimit": 4000
      }]
    }]
  }
}
